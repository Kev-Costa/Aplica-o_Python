SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_KEY=SUA_CHAVE_PUBLICA_ANON_OU_PUBLISHABLE
SUPABASE_TABLE=contatos
# Opcional: IDs separados por virgula para escolher exatamente quais contatos enviar.
# Exemplo: CONTACT_IDS=1,2,3
CONTACT_IDS=1,2,3

ZAPI_INSTANCE_ID=SEU_ID_DA_INSTANCIA
ZAPI_TOKEN=SEU_TOKEN_DA_INSTANCIA
ZAPI_CLIENT_TOKEN=SEU_CLIENT_TOKEN

MAX_CONTACTS=3
SUPABASE_TIMEOUT_SECONDS=15
DRY_RUN=true
LOG_LEVEL=INFO
